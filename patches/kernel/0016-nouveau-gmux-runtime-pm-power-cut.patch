From 0016-nouveau-gmux-runtime-pm-power-cut Mon Sep 17 00:00:00 2001
From: Igor Chicherin <ashzak990@gmail.com>
Date: Fri, 9 Oct 2026 00:00:00 +0300
Subject: [PATCH 0016/0016] nouveau/vga_switcheroo: cut dGPU power via apple-gmux on runtime suspend

With nouveau.runpm=1 on the MacBookPro11,3 (patches 0006/0008/0010 make it
safe), runtime suspend only puts the GT 750M into PCI D3hot: nouveau adds the
vga_switcheroo power domain - which calls the handler to cut power after the
driver suspends and to restore it before the driver resumes - only on v1-DSM
machines. On a dual-GPU Mac the power switch is apple-gmux, separate from the
device, so a "suspended" dGPU stays powered: the SMC GPU sensors (TG0D/TG1D)
sit at 57-62 C next to a 42 C case and the fans keep spinning, while
vga_switcheroo OFF (which does call gmux) leaves it cold.

* nouveau_vga_init(): also install the switcheroo power domain when an
  apple-gmux ACPI device is present. Runtime suspend then ends with
  gmux power_state(OFF), resume starts with gmux power_state(ON) followed by
  the ->reinit hook (0002) and nouveau's GK107 re-init (0007), the same
  sequence the manual vga_switcheroo OFF/ON path already uses.
* vga_switcheroo_runtime_suspend(): only switch the mux to the IGD when the
  IGD isn't already the active client. On apple-gmux a redundant switchto()
  rewrites the DDC/display mux on every runtime suspend.
* Tolerate a missing handler: apple-gmux registers it after nouveau may
  already runtime-suspend, and can be unloaded.
* vga_switcheroo_runtime_resume(): after the handler restores power, wait
  (up to 2 s) for the device to answer config reads before the PCI core
  powers it up. A gmux power-cut leaves the PCIe link down for ~300 ms, and
  pci_power_up() otherwise logs "Unable to change power state from D3cold
  to D0, device inaccessible" on every wake (nouveau's own resume, 0011,
  then recovers). Returns at once where power was never cut.

Only active with nouveau.runpm=1; the default (runpm=-1, no runtime PM on
this machine) is unchanged.

Signed-off-by: Igor Chicherin <ashzak990@gmail.com>
---
 drivers/gpu/drm/nouveau/nouveau_vga.c |   11 ++++++++
 drivers/gpu/vga/vga_switcheroo.c      |   44 +++++++++++++++++++++++++++++----
 2 files changed, 49 insertions(+), 6 deletions(-)

--- a/drivers/gpu/drm/nouveau/nouveau_vga.c
+++ b/drivers/gpu/drm/nouveau/nouveau_vga.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: MIT
 #include <linux/vgaarb.h>
 #include <linux/vga_switcheroo.h>
+#include <linux/apple-gmux.h>
 
 #include <drm/drm_client_event.h>
 
@@ -103,7 +104,15 @@
 
 	vga_switcheroo_register_client(pdev, &nouveau_switcheroo_ops, runtime);
 
-	if (runtime && nouveau_is_v1_dsm() && !nouveau_is_optimus())
+	/*
+	 * The dGPU's power switch is separate from the device on v1-DSM machines
+	 * and on dual-GPU Macs (apple-gmux cuts its rails). There, runtime suspend
+	 * alone only reaches PCI D3hot and the card stays powered and warm; the
+	 * switcheroo power domain makes it call the handler to cut power after
+	 * suspend and restore it (plus the ->reinit hook) before resume.
+	 */
+	if (runtime && !nouveau_is_optimus() &&
+	    (nouveau_is_v1_dsm() || apple_gmux_present()))
 		vga_switcheroo_init_domain_pm_ops(drm->dev->dev, &drm->vga_pm_domain);
 }
 
--- a/drivers/gpu/vga/vga_switcheroo.c
+++ b/drivers/gpu/vga/vga_switcheroo.c
@@ -33,6 +33,7 @@
 #include <linux/apple-gmux.h>
 #include <linux/console.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/fb.h>
 #include <linux/fs.h>
 #include <linux/fbcon.h>
@@ -1025,7 +1026,8 @@
 {
 	struct vga_switcheroo_client *client;
 
-	if (!vgasr_priv.handler->power_state)
+	/* apple-gmux registers the handler late (or unloads); no handler, no switch */
+	if (!vgasr_priv.handler || !vgasr_priv.handler->power_state)
 		return;
 
 	client = find_client_from_pci(&vgasr_priv.clients, pdev);
@@ -1048,10 +1050,20 @@
 	if (ret)
 		return ret;
 	mutex_lock(&vgasr_mutex);
-	if (vgasr_priv.handler->switchto) {
-		mutex_lock(&vgasr_priv.mux_hw_lock);
-		vgasr_priv.handler->switchto(VGA_SWITCHEROO_IGD);
-		mutex_unlock(&vgasr_priv.mux_hw_lock);
+	if (vgasr_priv.handler && vgasr_priv.handler->switchto) {
+		struct vga_switcheroo_client *active =
+			find_active_client(&vgasr_priv.clients);
+
+		/*
+		 * Point the mux at the IGD before cutting the DIS. Skip it when
+		 * the IGD already drives the panel: on apple-gmux a redundant
+		 * switch rewrites the display mux on every runtime suspend.
+		 */
+		if (!active || active->id != VGA_SWITCHEROO_IGD) {
+			mutex_lock(&vgasr_priv.mux_hw_lock);
+			vgasr_priv.handler->switchto(VGA_SWITCHEROO_IGD);
+			mutex_unlock(&vgasr_priv.mux_hw_lock);
+		}
 	}
 	pci_bus_set_current_state(pdev->bus, PCI_D3cold);
 	vga_switcheroo_power_switch(pdev, VGA_SWITCHEROO_OFF);
@@ -1059,6 +1071,27 @@
 	return 0;
 }
 
+/*
+ * After the handler restores power that was really cut (apple-gmux), the PCIe
+ * link needs ~300 ms to retrain and config reads return all-ones until then.
+ * Wait for the device to answer before the PCI core powers it up, or
+ * pci_power_up() fails with "Unable to change power state from D3cold to D0,
+ * device inaccessible". Returns at once where power was never cut.
+ */
+static void vga_switcheroo_wait_for_device(struct pci_dev *pdev)
+{
+	u32 id;
+	int i;
+
+	for (i = 0; i < 40; i++) {		/* 40 * 50 ms = 2 s, as nouveau's resume */
+		pci_read_config_dword(pdev, PCI_VENDOR_ID, &id);
+		if (!PCI_POSSIBLE_ERROR(id))
+			return;
+		msleep(50);
+	}
+	pci_warn(pdev, "no config space response 2 s after power-on\n");
+}
+
 static int vga_switcheroo_runtime_resume(struct device *dev)
 {
 	struct pci_dev *pdev = to_pci_dev(dev);
@@ -1066,6 +1099,7 @@
 	mutex_lock(&vgasr_mutex);
 	vga_switcheroo_power_switch(pdev, VGA_SWITCHEROO_ON);
 	mutex_unlock(&vgasr_mutex);
+	vga_switcheroo_wait_for_device(pdev);
 	pci_resume_bus(pdev->bus);
 	/*
 	 * The handler's power_state(ON) above may have been a hard
